{
  "name": "intentguard",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @intentguard/api dev",
    "dev:web": "pnpm --filter @intentguard/web dev",
    "test": "pnpm -r test && pnpm test:e2e",
    "test:unit": "pnpm -r test",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "test:contracts": "cd packages/contracts && forge test",
    "typecheck": "tsc --noEmit && pnpm --filter @intentguard/web typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "sabotage": "tsx scripts/sabotage.mts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@google/genai": "^2.17.0",
    "hono": "^4.13.18",
    "viem": "^2.21.55",
    "zod": "^3.24.1"
  },
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "packageManager": "pnpm@10.28.0"
}
