# IntentGuard configuration. Copy to `.env` (git-ignored) and fill in.
# Every variable is optional: without them the API runs fully offline with a
# deterministic review, skipped fork simulation and unsigned attestations.

# --- API (packages/api) ------------------------------------------------------
# Google Gemini key for the live Proposer / Red Team / Arbiter review.
# Free tier available at https://ai.google.dev
GEMINI_API_KEY=
# RPC the risk oracle reads settler contracts from (default http://127.0.0.1:8545).
BASE_SEPOLIA_RPC=https://sepolia.base.org
# Mainnet RPC used to start an Anvil fork for pre-sign simulation (requires `anvil`).
MAINNET_RPC=
# Throwaway demo EOA that signs EIP-712 risk attestations. NEVER a real key.
ATTESTOR_PRIVATE_KEY=
# Deployed PolicyVault the attestations are bound to.
VAULT_ADDRESS=
# Comma-separated origins allowed to call the API cross-origin (empty = none).
CORS_ORIGINS=
# Set to "true" to expose POST /sabotage when NODE_ENV=production.
ENABLE_SABOTAGE=
# Listen address (defaults: 127.0.0.1:4000).
HOST=
PORT=

# --- Contracts deployment (packages/contracts/script/Deploy.s.sol) -----------
DEPLOYER_PRIVATE_KEY=
ATTESTOR_ADDRESS=
DEMO_USER_ADDRESS=

# --- Sabotage demo (scripts/sabotage.mts) ------------------------------------
# Uses VAULT_ADDRESS and ATTESTOR_PRIVATE_KEY from above.
RPC_URL=http://127.0.0.1:8545
